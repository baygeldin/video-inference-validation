FROM nvidia/cuda:13.0.2-devel-ubuntu24.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG PYTHON_VERSION=3.13.11

ENV DEBIAN_FRONTEND=noninteractive \
    SHELL=/bin/bash

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    ffmpeg \
    file \
    git \
    git-lfs \
    libffi-dev \
    libgl1 \
    libglib2.0-0 \
    libjpeg-dev \
    libnuma1 \
    libsm6 \
    libssl-dev \
    libxext6 \
    libxrender1 \
    ninja-build \
    openssh-server \
    pkg-config \
    vim \
    zstd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.17 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PIP_ROOT_USER_ACTION=ignore \
    UV_LINK_MODE=copy \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    VIRTUAL_ENV=/opt/venv \
    XDG_CACHE_HOME=/workspace/.cache \
    HF_HOME=/workspace/.cache/huggingface \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    HF_XET_HIGH_PERFORMANCE=1 \
    VLLM_OMNI_TARGET_DEVICE=cuda \
    PATH=/opt/venv/bin:$PATH

RUN git lfs install --system \
    && uv python install "${PYTHON_VERSION}" \
    && uv venv --python "${PYTHON_VERSION}" "${VIRTUAL_ENV}" \
    && ln -sf "${VIRTUAL_ENV}/bin/python" /usr/local/bin/python \
    && ln -sf "${VIRTUAL_ENV}/bin/python" /usr/local/bin/python3

COPY pyproject.toml uv.lock .python-version configs.yml /opt/video-inference-validation/
RUN uv sync --project /opt/video-inference-validation --locked --no-dev --no-install-project

COPY src /opt/video-inference-validation/src
COPY prompts /opt/video-inference-validation/prompts
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

RUN uv sync --project /opt/video-inference-validation --locked --no-dev \
    && chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["sleep", "infinity"]
