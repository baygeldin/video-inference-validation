FROM nvidia/cuda:13.0.2-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    ffmpeg \
    git \
    git-lfs \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    UV_TORCH_BACKEND=cu130 \
    HF_HOME=/workspace/hf-cache \
    VLLM_OMNI_TARGET_DEVICE=cuda \
    PATH=/opt/venv/bin:$PATH

RUN python3 -m pip install --break-system-packages --no-cache-dir uv

WORKDIR /opt/video-inference-validation

ARG VLLM_VERSION=0.20.0
ARG VLLM_OMNI_REF=v0.20.0

RUN python3 -m venv /opt/venv

RUN uv pip install vllm==${VLLM_VERSION} --torch-backend=cu130 \
    && git clone --branch ${VLLM_OMNI_REF} --depth 1 https://github.com/vllm-project/vllm-omni.git /opt/vllm-omni \
    && cd /opt/vllm-omni \
    && uv pip install -e .

COPY pyproject.toml ./
COPY src ./src
COPY prompts ./prompts

RUN uv pip install -e /opt/video-inference-validation

WORKDIR /workspace

CMD ["sleep", "infinity"]
