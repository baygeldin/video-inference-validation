FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=1 \
    HF_HOME=/workspace/hf-cache

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    ffmpeg \
    git \
    git-lfs \
    jq \
    python3 \
    python3-pip \
    python3-venv \
    rsync \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --upgrade pip uv awscli

WORKDIR /opt/video-inference-validation
COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
COPY patches ./patches
COPY scripts ./scripts

RUN git clone --depth 1 https://github.com/vllm-project/vllm-omni.git /opt/vllm-omni \
    && cd /opt/vllm-omni \
    && git apply /opt/video-inference-validation/patches/vllm-omni-wan22-latent-capture.patch \
    && python3 -m pip install --no-cache-dir -e .

RUN python3 -m pip install --no-cache-dir -e /opt/video-inference-validation

WORKDIR /workspace
CMD ["/bin/bash"]
