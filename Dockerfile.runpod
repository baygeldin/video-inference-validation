FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=1 \
    HF_HOME=/workspace/hf-cache

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    ffmpeg \
    git \
    git-lfs \
    jq \
    python3 \
    python3-pip \
    python3-venv \
    rsync \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --upgrade pip uv

WORKDIR /opt/video-inference-validation
COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
COPY runtime_patches ./runtime_patches
COPY scripts ./scripts

RUN python3 -m pip install --no-cache-dir -e /opt/video-inference-validation \
    && python3 -m pip install --no-cache-dir git+https://github.com/vllm-project/vllm-omni.git

WORKDIR /workspace
CMD ["/bin/bash"]
